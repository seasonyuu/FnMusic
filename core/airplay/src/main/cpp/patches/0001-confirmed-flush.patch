+
+bool RaopSender::flushAudio() {
+    if (state_ != State::Streaming || flushPending_) return false;
+    // Called only by the single network owner; the host must stop feeding PCM
+    // until flushPending() clears. No old packet may be retransmitted after this.
+    if (ring_) ring_->reset();
+    inBuf_.clear();
+    srcPhase_ = 0;
+    for (auto& packet : backlog_) packet.clear();
+    std::fill(backlogSeq_.begin(), backlogSeq_.end(), -1);
+    Extra headers{{"RTP-Info", "seq=" + std::to_string(seq_) +
+                              ";rtptime=" + std::to_string(rtptime32_())}};
+    if (!rtspSession_.empty()) headers.push_back({"Session", rtspSession_});
+    flushPending_ = true;
+    sendRequest_("FLUSH", rtspUri_(), {}, {}, headers);
+    return true;
 }
 
