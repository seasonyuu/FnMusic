+void RaopSender::setPlaybackInfo(int64_t positionMs, int64_t durationMs, bool playing) {
+    npPositionMs_ = std::max<int64_t>(0, positionMs);
+    npDurationMs_ = std::max<int64_t>(0, durationMs);
+    npPlaying_ = playing;
+    if (state_ != State::Streaming) return;
+    const uint32_t current = rtptime32_();
+    const uint32_t start = current - uint32_t(uint64_t(npPositionMs_) * 44100 / 1000);
+    const uint32_t end = start + uint32_t(uint64_t(npDurationMs_) * 44100 / 1000);
+    sendRequest_("SET_PARAMETER", rtspUri_(), "text/parameters",
+        "progress: " + std::to_string(start) + "/" + std::to_string(current) + "/" + std::to_string(end) + "\r\n");
